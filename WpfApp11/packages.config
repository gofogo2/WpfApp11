<?xml version="1.0" encoding="utf-8"?>
<!-- 
  NuGet 패키지 관리 구성 파일
  - 이 프로젝트에서 사용하는 NuGet 패키지 목록
  - 패키지 ID, 버전, 대상 프레임워크를 정의
-->
<packages>
  <!-- 
    FluentFTP 패키지 (v50.1.0)
    - FTP 클라이언트 기능을 제공하는 라이브러리
    - 파일 업로드/다운로드, 디렉토리 생성/삭제 등의 기능 지원
  -->
  <package id="FluentFTP" version="50.1.0" targetFramework="net472" />
  <!-- 
    Newtonsoft.Json 패키지 (v13.0.3)
    - JSON 데이터 처리를 위한 라이브러리
    - JSON 직렬화/역직렬화, JSON 객체 조작 기능 제공
  -->
  <package id="Newtonsoft.Json" version="13.0.3" targetFramework="net472" />
</packages>